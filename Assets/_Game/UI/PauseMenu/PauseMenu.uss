.pause-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(2, 30, 29, 0.72);
    align-items: center;
    justify-content: center;
    padding: 28px;
}

.hidden {
    display: none;
}

.pause-panel {
    width: 820px;
    max-width: 94%;
    max-height: 92%;
    background-color: rgba(5, 47, 44, 0.96);
    border-width: 3px;
    border-color: rgba(255, 211, 82, 0.78);
    border-radius: 28px;
    padding: 30px 34px 26px 34px;
}

.pause-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
}

.pause-title {
    font-size: 36px;
    unity-font-style: bold;
    color: rgb(255, 202, 64);
    letter-spacing: 3px;
}

.pause-hint {
    font-size: 14px;
    color: rgb(91, 224, 229);
}

.pause-body {
    flex-direction: row;
}

.pause-actions {
    width: 330px;
    margin-right: 26px;
}

.menu-button {
    height: 50px;
    margin-bottom: 12px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(128, 228, 148, 0.52);
    background-color: rgba(16, 92, 76, 0.88);
    color: rgb(255, 249, 218);
    font-size: 15px;
    unity-font-style: bold;
    -unity-text-align: middle-center;
}

.menu-button:hover,
.menu-button:focus {
    background-color: rgb(255, 202, 64);
    border-color: rgb(255, 246, 176);
    color: rgb(13, 75, 57);
}

.primary {
    background-color: rgb(255, 202, 64);
    color: rgb(13, 75, 57);
}

.danger {
    background-color: rgb(207, 94, 70);
    border-color: rgb(255, 173, 139);
}

.compact {
    width: 150px;
    margin-top: 8px;
}

.settings-panel {
    flex-grow: 1;
    min-width: 330px;
    padding: 16px;
    background-color: rgba(3, 42, 39, 0.72);
    border-width: 2px;
    border-color: rgba(92, 225, 167, 0.35);
    border-radius: 18px;
}

.section-title {
    font-size: 20px;
    unity-font-style: bold;
    color: rgb(91, 224, 229);
    margin-bottom: 10px;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 42px;
}

.setting-label {
    width: 84px;
    color: rgba(255, 249, 218, 0.9);
    font-size: 14px;
}

.setting-slider {
    flex-grow: 1;
}

.setting-toggle {
    margin-top: 6px;
    margin-bottom: 10px;
    color: rgb(255, 249, 218);
}
