:root {
    --er-bg: rgba(5, 6, 5, 0.76);
    --er-panel: rgba(17, 17, 14, 0.72);
    --er-row: rgba(33, 31, 24, 0.58);
    --er-row-alt: rgba(42, 39, 30, 0.46);
    --er-line: rgba(201, 191, 150, 0.24);
    --er-line-strong: rgba(230, 220, 180, 0.52);
    --er-text: rgb(226, 220, 200);
    --er-muted: rgba(218, 210, 184, 0.68);
    --er-highlight: rgba(209, 202, 161, 0.28);
    --er-highlight-border: rgb(232, 226, 188);
    --er-danger: rgb(119, 62, 55);
}

.panel-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 30px 42px;
    background-color: var(--er-bg);
    align-items: stretch;
    justify-content: center;
}

.panel-container {
    width: 1240px;
    max-width: 98%;
    height: 92%;
    max-height: 820px;
    background-color: var(--er-panel);
    border-width: 1px;
    border-color: rgba(203, 193, 155, 0.16);
    padding: 24px 34px 18px 34px;
}

.title-row {
    flex-direction: row;
    align-items: center;
    height: 64px;
    margin-bottom: 16px;
}

.title-emblem {
    width: 46px;
    height: 46px;
    margin-right: 14px;
    background-color: rgba(194, 178, 126, 0.22);
    border-width: 1px;
    border-color: rgba(226, 216, 174, 0.45);
}

.title {
    font-size: 27px;
    color: var(--er-text);
    -unity-font-style: bold;
}

.device-mode-section {
    margin-left: 255px;
    margin-right: 255px;
    margin-bottom: 16px;
}

.section-label {
    color: rgb(221, 211, 170);
    font-size: 18px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.device-mode-buttons {
    flex-direction: row;
    height: 42px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--er-line);
}

.mode-button {
    flex-grow: 1;
    height: 38px;
    margin: 2px 4px;
    background-color: rgba(31, 30, 24, 0.68);
    color: var(--er-muted);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    font-size: 15px;
}

.mode-button:hover,
.mode-button:focus,
.mode-active {
    color: var(--er-text);
    background-color: var(--er-highlight);
    border-color: var(--er-highlight-border);
}

.header-row {
    height: 36px;
    border-bottom-width: 1px;
    border-color: var(--er-line);
}

.col-header {
    color: var(--er-muted);
    -unity-text-align: middle-center;
    font-size: 15px;
}

.rebind-row {
    flex-direction: row;
    align-items: center;
    min-height: 48px;
    padding: 3px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(210, 200, 160, 0.12);
    background-color: var(--er-row);
}

.rebind-row-alt {
    background-color: var(--er-row-alt);
}

.col-action {
    width: 41%;
    color: var(--er-text);
    font-size: 18px;
    -unity-text-align: middle-left;
}

.col-binding {
    width: 19.666%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.rebind-button {
    width: 92%;
    height: 34px;
    color: var(--er-text);
    background-color: rgba(8, 8, 6, 0.58);
    border-width: 1px;
    border-color: rgba(226, 218, 180, 0.34);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.rebind-button:hover,
.rebind-button:focus {
    background-color: var(--er-highlight);
    border-color: var(--er-highlight-border);
    border-width: 2px;
}

.rebinding {
    background-color: rgba(190, 174, 110, 0.42);
    border-color: rgb(255, 242, 189);
}

.rebind-list {
    flex-grow: 1;
    min-height: 260px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--er-line);
    margin-bottom: 12px;
}

.sensitivity-section {
    flex-direction: row;
    align-items: center;
    min-height: 42px;
    margin-bottom: 10px;
}

.setting-label {
    width: 245px;
    color: var(--er-muted);
    font-size: 15px;
}

.sensitivity-slider {
    flex-grow: 1;
    margin-right: 12px;
}

.sensitivity-value-label {
    width: 56px;
    color: var(--er-text);
    -unity-text-align: middle-right;
}

.description-panel {
    height: 68px;
    background-color: rgba(9, 9, 7, 0.42);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(210, 200, 160, 0.14);
    justify-content: center;
    padding-left: 16px;
    margin-bottom: 10px;
}

.description-text {
    color: var(--er-muted);
    font-size: 16px;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 42px;
}

.footer-hints,
.footer-buttons {
    flex-direction: row;
    align-items: center;
}

.footer-hint {
    color: var(--er-muted);
    font-size: 15px;
    margin-right: 14px;
}

.ok-hint {
    color: rgb(166, 218, 146);
}

.back-hint {
    color: rgb(224, 138, 126);
}

.action-button {
    min-width: 118px;
    height: 34px;
    margin-left: 8px;
    color: var(--er-text);
    background-color: rgba(30, 29, 24, 0.86);
    border-width: 1px;
    border-color: var(--er-line);
    font-size: 14px;
}

.action-button:hover,
.action-button:focus {
    background-color: var(--er-highlight);
    border-color: var(--er-highlight-border);
}

.reset-button {
    background-color: rgba(92, 50, 46, 0.85);
}

.confirm-button {
    background-color: rgba(71, 88, 57, 0.9);
}

.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.74);
    align-items: center;
    justify-content: center;
}

.modal-content {
    min-width: 520px;
    max-width: 720px;
    padding: 30px 38px;
    background-color: rgba(20, 19, 15, 0.96);
    border-width: 1px;
    border-color: var(--er-line-strong);
    align-items: center;
}

.modal-prompt {
    color: var(--er-text);
    font-size: 20px;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.modal-button-row {
    flex-direction: row;
    justify-content: center;
}

.hidden {
    display: none;
}
