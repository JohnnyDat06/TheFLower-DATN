:root {
    --er-bg: rgba(2, 30, 29, 0.72);
    --er-panel: rgba(5, 47, 44, 0.96);
    --er-row: rgba(225, 255, 223, 0.08);
    --er-row-alt: rgba(255, 221, 92, 0.09);
    --er-line: rgba(92, 225, 167, 0.32);
    --er-line-strong: rgba(255, 202, 64, 0.78);
    --er-text: rgb(255, 249, 218);
    --er-muted: rgba(224, 250, 225, 0.76);
    --er-highlight: rgba(91, 224, 229, 0.22);
    --er-highlight-border: rgb(91, 224, 229);
}

.panel-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 12px;
    background-color: var(--er-bg);
    align-items: center;
    justify-content: center;
}

.panel-container {
    width: 1080px;
    max-width: 94%;
    height: 86%;
    max-height: 820px;
    min-height: 640px;
    background-color: var(--er-panel);
    border-width: 3px;
    border-color: rgba(255, 211, 82, 0.78);
    border-radius: 28px;
    padding: 26px 38px 22px 38px;
}

.title-row {
    flex-direction: row;
    align-items: center;
    height: 68px;
    margin-bottom: 12px;
}

.title-emblem {
    width: 52px;
    height: 52px;
    margin-right: 14px;
    background-color: rgb(255, 202, 64);
    border-width: 3px;
    border-color: rgb(255, 243, 164);
    border-radius: 26px;
    align-items: center;
    justify-content: center;
}

.emblem-text {
    color: rgb(25, 119, 74);
    font-size: 30px;
    -unity-font-style: bold;
}

.title {
    font-size: 29px;
    color: rgb(255, 202, 64);
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.device-mode-section {
    width: 680px;
    align-self: center;
    margin-bottom: 12px;
}

.section-label {
    color: rgb(91, 224, 229);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.tab-switch-hint {
    color: var(--er-muted);
    font-size: 13px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.device-mode-buttons {
    flex-direction: row;
    height: 46px;
    padding: 3px;
    background-color: rgba(3, 37, 36, 0.78);
    border-radius: 23px;
}

.mode-button {
    flex-grow: 1;
    height: 40px;
    margin: 0 3px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--er-muted);
    border-width: 0;
    border-radius: 20px;
    font-size: 14px;
    -unity-font-style: bold;
}

.mode-button:hover,
.mode-button:focus,
.mode-active {
    color: var(--er-text);
    background-color: var(--er-highlight);
    border-color: var(--er-highlight-border);
}

.mode-active {
    color: rgb(13, 75, 57);
    background-color: rgb(255, 202, 64);
}

.gamepad-map {
    height: 330px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
}

.gamepad-diagram {
    width: 920px;
    height: 320px;
    align-self: center;
    background-color: rgba(9, 9, 7, 0.36);
    border-width: 2px;
    border-color: rgba(92, 225, 167, 0.45);
    border-radius: 18px;
}

.gamepad-image {
    position: absolute;
    left: 230px;
    top: 0px;
    width: 460px;
    height: 320px;
    background-image: url("xbox.png");
    -unity-background-scale-mode: scale-to-fit;
}

.pad-binding {
    position: absolute;
    width: 154px;
    height: 50px;
    padding-left: 8px;
    padding-right: 8px;
    color: var(--er-text);
    background-color: rgb(228, 250, 206);
    border-width: 2px;
    border-color: rgba(128, 228, 148, 0.72);
    border-radius: 12px;
    color: rgb(8, 65, 52);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.pad-binding:hover,
.pad-binding:focus {
    color: rgb(70, 54, 7);
    background-color: rgb(255, 202, 64);
    border-color: rgb(255, 246, 176);
    border-width: 2px;
}

.pad-info {
    position: absolute;
    min-width: 154px;
    height: 28px;
    padding-left: 6px;
    padding-right: 6px;
    color: var(--er-muted);
    background-color: rgba(18, 18, 14, 0.72);
    border-width: 1px;
    border-color: rgba(232, 226, 188, 0.2);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.connector,
.pad-info {
    display: none;
}

.connector {
    position: absolute;
    height: 1px;
    background-color: rgba(92, 225, 167, 0.54);
}

.connector-lb { left: 224px; top: 40px; width: 98px; }
.connector-rb { left: 498px; top: 40px; width: 98px; }
.connector-lt { left: 216px; top: 18px; width: 112px; }
.connector-rt { left: 492px; top: 18px; width: 112px; }
.connector-dpad-left { left: 286px; top: 205px; width: 88px; }
.connector-dpad-right { left: 594px; top: 205px; width: 40px; }
.connector-left-stick { left: 282px; top: 140px; width: 92px; }
.connector-right-stick { left: 594px; top: 166px; width: 92px; }
.connector-face { left: 594px; top: 124px; width: 90px; }
.connector-menu { left: 550px; top: 74px; width: 44px; }
.connector-lb { left: 282px; top: 52px; width: 72px; }
.connector-rb { left: 594px; top: 52px; width: 72px; }
.connector-lt { left: 270px; top: 30px; width: 84px; }
.connector-rt { left: 594px; top: 30px; width: 84px; }

.pad-binding-dpad-left { left: 24px; top: 184px; }
.pad-binding-dpad-right { right: 24px; top: 184px; }
.pad-binding-y { right: 24px; top: 94px; color: rgb(230, 210, 90); }
.pad-binding-x { right: 24px; top: 140px; color: rgb(120, 165, 235); }
.pad-binding-b { right: 24px; top: 186px; color: rgb(235, 105, 95); }
.pad-binding-a { right: 24px; top: 232px; color: rgb(112, 210, 110); }
.pad-binding-left-stick { left: 24px; top: 92px; }
.pad-info-lb { left: 24px; top: 30px; }
.pad-info-rb { right: 24px; top: 30px; }
.pad-info-lt { left: 24px; top: 0px; }
.pad-info-rt { right: 24px; top: 0px; }
.pad-info-left-stick { left: 24px; top: 138px; }
.pad-info-right-stick { right: 24px; top: 138px; }
.pad-info-menu { right: 24px; top: 62px; }

.header-row {
    height: 34px;
    border-bottom-width: 1px;
    border-color: var(--er-line);
}

.col-header {
    color: var(--er-muted);
    -unity-text-align: middle-center;
    font-size: 15px;
}

.rebind-row {
    flex-direction: row;
    align-items: center;
    min-height: 46px;
    padding: 3px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(133, 235, 183, 0.16);
    border-radius: 10px;
    background-color: var(--er-row);
}

.rebind-row-alt {
    background-color: var(--er-row-alt);
}

.col-action {
    width: 44%;
    color: var(--er-text);
    font-size: 18px;
    -unity-text-align: middle-left;
}

.col-binding {
    width: 28%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.rebind-button {
    width: 92%;
    height: 34px;
    color: rgb(8, 65, 52);
    background-color: rgb(228, 250, 206);
    border-width: 2px;
    border-color: rgba(128, 228, 148, 0.72);
    border-radius: 12px;
    font-size: 15px;
    -unity-text-align: middle-center;
}

.rebind-button:hover,
.rebind-button:focus {
    color: rgb(70, 54, 7);
    background-color: rgb(255, 202, 64);
    border-color: rgb(255, 246, 176);
    border-width: 2px;
}

.rebinding {
    background-color: rgba(190, 174, 110, 0.42);
    border-color: rgb(255, 242, 189);
}

.rebind-list {
    flex-grow: 1;
    min-height: 220px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--er-line);
    margin-bottom: 10px;
}

.sensitivity-section {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    margin-bottom: 8px;
}

.setting-label {
    width: 245px;
    color: var(--er-muted);
    font-size: 15px;
}

.sensitivity-slider {
    flex-grow: 1;
    margin-right: 12px;
}

.sensitivity-value-label {
    width: 56px;
    color: var(--er-text);
    -unity-text-align: middle-right;
}

.description-panel {
    height: 58px;
    background-color: rgba(9, 9, 7, 0.42);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(210, 200, 160, 0.14);
    justify-content: center;
    padding-left: 16px;
    margin-bottom: 8px;
}

.description-text {
    color: var(--er-muted);
    font-size: 16px;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 42px;
}

.footer-hints,
.footer-buttons {
    flex-direction: row;
    align-items: center;
}

.footer-hint {
    color: var(--er-muted);
    font-size: 15px;
    margin-right: 12px;
}

.ok-hint {
    color: rgb(166, 218, 146);
}

.back-hint {
    color: rgb(224, 138, 126);
}

.action-button {
    min-width: 140px;
    height: 42px;
    margin-left: 8px;
    color: var(--er-text);
    background-color: rgb(255, 202, 64);
    border-width: 2px;
    border-color: rgb(255, 241, 157);
    border-radius: 14px;
    font-size: 14px;
}

.action-button:hover,
.action-button:focus {
    background-color: rgb(255, 249, 218);
    border-color: rgb(91, 224, 229);
}

.reset-button {
    color: rgb(255, 249, 218);
    background-color: rgb(207, 94, 70);
    border-color: rgb(255, 173, 139);
}

.confirm-button {
    background-color: rgb(255, 202, 64);
}

.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(2, 26, 25, 0.84);
    align-items: center;
    justify-content: center;
}

.modal-content {
    min-width: 520px;
    max-width: 720px;
    padding: 32px 40px;
    background-color: rgba(10, 70, 62, 0.94);
    border-width: 3px;
    border-color: rgb(255, 202, 64);
    border-radius: 24px;
    align-items: center;
}

.modal-prompt {
    color: rgb(255, 249, 218);
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.modal-button-row {
    flex-direction: row;
    justify-content: center;
}

.hidden {
    display: none;
}
