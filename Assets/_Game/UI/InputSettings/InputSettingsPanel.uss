:root {
    --er-bg: rgba(5, 6, 5, 0.76);
    --er-panel: rgba(17, 17, 14, 0.82);
    --er-row: rgba(33, 31, 24, 0.58);
    --er-row-alt: rgba(42, 39, 30, 0.46);
    --er-line: rgba(201, 191, 150, 0.24);
    --er-line-strong: rgba(230, 220, 180, 0.52);
    --er-text: rgb(226, 220, 200);
    --er-muted: rgba(218, 210, 184, 0.68);
    --er-highlight: rgba(209, 202, 161, 0.28);
    --er-highlight-border: rgb(232, 226, 188);
}

.panel-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 28px;
    background-color: var(--er-bg);
    align-items: center;
    justify-content: center;
}

.panel-container {
    width: 1080px;
    max-width: 94%;
    height: 86%;
    max-height: 820px;
    min-height: 640px;
    background-color: var(--er-panel);
    border-width: 1px;
    border-color: rgba(203, 193, 155, 0.18);
    padding: 22px 30px 16px 30px;
}

.title-row {
    flex-direction: row;
    align-items: center;
    height: 58px;
    margin-bottom: 12px;
}

.title-emblem {
    width: 44px;
    height: 44px;
    margin-right: 14px;
    background-color: rgba(194, 178, 126, 0.22);
    border-width: 1px;
    border-color: rgba(226, 216, 174, 0.45);
}

.title {
    font-size: 27px;
    color: var(--er-text);
    -unity-font-style: bold;
}

.device-mode-section {
    width: 520px;
    align-self: center;
    margin-bottom: 12px;
}

.section-label {
    color: rgb(221, 211, 170);
    font-size: 18px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.tab-switch-hint {
    color: rgba(218, 210, 184, 0.72);
    font-size: 13px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.device-mode-buttons {
    flex-direction: row;
    height: 42px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--er-line);
}

.mode-button {
    flex-grow: 1;
    height: 38px;
    margin: 2px 4px;
    background-color: rgba(31, 30, 24, 0.68);
    color: var(--er-muted);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    font-size: 15px;
}

.mode-button:hover,
.mode-button:focus,
.mode-active {
    color: var(--er-text);
    background-color: var(--er-highlight);
    border-color: var(--er-highlight-border);
}

.gamepad-map {
    height: 300px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
}

.gamepad-diagram {
    width: 920px;
    height: 288px;
    align-self: center;
    background-color: rgba(9, 9, 7, 0.36);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(210, 200, 160, 0.14);
}

.gamepad-image {
    position: absolute;
    left: 280px;
    top: 0px;
    width: 360px;
    height: 288px;
    background-image: url("../PauseMenu/Gamepad.png");
    -unity-background-scale-mode: scale-to-fit;
}

.pad-binding {
    position: absolute;
    width: 154px;
    height: 50px;
    padding-left: 8px;
    padding-right: 8px;
    color: var(--er-text);
    background-color: rgba(18, 18, 14, 0.88);
    border-width: 1px;
    border-color: rgba(232, 226, 188, 0.38);
    border-radius: 4px;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.pad-binding:hover,
.pad-binding:focus {
    background-color: var(--er-highlight);
    border-color: var(--er-highlight-border);
    border-width: 2px;
}

.pad-info {
    position: absolute;
    min-width: 154px;
    height: 28px;
    padding-left: 6px;
    padding-right: 6px;
    color: var(--er-muted);
    background-color: rgba(18, 18, 14, 0.72);
    border-width: 1px;
    border-color: rgba(232, 226, 188, 0.2);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.connector {
    position: absolute;
    height: 1px;
    background-color: rgba(232, 226, 188, 0.54);
}

.connector-lb { left: 224px; top: 40px; width: 98px; }
.connector-rb { left: 498px; top: 40px; width: 98px; }
.connector-lt { left: 216px; top: 18px; width: 112px; }
.connector-rt { left: 492px; top: 18px; width: 112px; }
.connector-dpad-left { left: 286px; top: 205px; width: 88px; }
.connector-dpad-right { left: 594px; top: 205px; width: 40px; }
.connector-left-stick { left: 282px; top: 140px; width: 92px; }
.connector-right-stick { left: 594px; top: 166px; width: 92px; }
.connector-face { left: 594px; top: 124px; width: 90px; }
.connector-menu { left: 550px; top: 74px; width: 44px; }
.connector-lb { left: 282px; top: 52px; width: 72px; }
.connector-rb { left: 594px; top: 52px; width: 72px; }
.connector-lt { left: 270px; top: 30px; width: 84px; }
.connector-rt { left: 594px; top: 30px; width: 84px; }

.pad-binding-dpad-left { left: 24px; top: 184px; }
.pad-binding-dpad-right { right: 24px; top: 184px; }
.pad-binding-y { right: 24px; top: 94px; color: rgb(230, 210, 90); }
.pad-binding-x { right: 24px; top: 140px; color: rgb(120, 165, 235); }
.pad-binding-b { right: 24px; top: 186px; color: rgb(235, 105, 95); }
.pad-binding-a { right: 24px; top: 232px; color: rgb(112, 210, 110); }
.pad-binding-left-stick { left: 24px; top: 92px; }
.pad-info-lb { left: 24px; top: 30px; }
.pad-info-rb { right: 24px; top: 30px; }
.pad-info-lt { left: 24px; top: 0px; }
.pad-info-rt { right: 24px; top: 0px; }
.pad-info-left-stick { left: 24px; top: 138px; }
.pad-info-right-stick { right: 24px; top: 138px; }
.pad-info-menu { right: 24px; top: 62px; }

.header-row {
    height: 34px;
    border-bottom-width: 1px;
    border-color: var(--er-line);
}

.col-header {
    color: var(--er-muted);
    -unity-text-align: middle-center;
    font-size: 15px;
}

.rebind-row {
    flex-direction: row;
    align-items: center;
    min-height: 46px;
    padding: 3px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(210, 200, 160, 0.12);
    background-color: var(--er-row);
}

.rebind-row-alt {
    background-color: var(--er-row-alt);
}

.col-action {
    width: 44%;
    color: var(--er-text);
    font-size: 18px;
    -unity-text-align: middle-left;
}

.col-binding {
    width: 28%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.rebind-button {
    width: 92%;
    height: 34px;
    color: var(--er-text);
    background-color: rgba(8, 8, 6, 0.58);
    border-width: 1px;
    border-color: rgba(226, 218, 180, 0.34);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.rebind-button:hover,
.rebind-button:focus {
    background-color: var(--er-highlight);
    border-color: var(--er-highlight-border);
    border-width: 2px;
}

.rebinding {
    background-color: rgba(190, 174, 110, 0.42);
    border-color: rgb(255, 242, 189);
}

.rebind-list {
    flex-grow: 1;
    min-height: 220px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--er-line);
    margin-bottom: 10px;
}

.sensitivity-section {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    margin-bottom: 8px;
}

.setting-label {
    width: 245px;
    color: var(--er-muted);
    font-size: 15px;
}

.sensitivity-slider {
    flex-grow: 1;
    margin-right: 12px;
}

.sensitivity-value-label {
    width: 56px;
    color: var(--er-text);
    -unity-text-align: middle-right;
}

.description-panel {
    height: 58px;
    background-color: rgba(9, 9, 7, 0.42);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(210, 200, 160, 0.14);
    justify-content: center;
    padding-left: 16px;
    margin-bottom: 8px;
}

.description-text {
    color: var(--er-muted);
    font-size: 16px;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 42px;
}

.footer-hints,
.footer-buttons {
    flex-direction: row;
    align-items: center;
}

.footer-hint {
    color: var(--er-muted);
    font-size: 15px;
    margin-right: 12px;
}

.ok-hint {
    color: rgb(166, 218, 146);
}

.back-hint {
    color: rgb(224, 138, 126);
}

.action-button {
    min-width: 118px;
    height: 34px;
    margin-left: 8px;
    color: var(--er-text);
    background-color: rgba(30, 29, 24, 0.86);
    border-width: 1px;
    border-color: var(--er-line);
    font-size: 14px;
}

.action-button:hover,
.action-button:focus {
    background-color: var(--er-highlight);
    border-color: var(--er-highlight-border);
}

.reset-button {
    background-color: rgba(92, 50, 46, 0.85);
}

.confirm-button {
    background-color: rgba(71, 88, 57, 0.9);
}

.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.74);
    align-items: center;
    justify-content: center;
}

.modal-content {
    min-width: 520px;
    max-width: 720px;
    padding: 30px 38px;
    background-color: rgba(20, 19, 15, 0.96);
    border-width: 1px;
    border-color: var(--er-line-strong);
    align-items: center;
}

.modal-prompt {
    color: var(--er-text);
    font-size: 20px;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.modal-button-row {
    flex-direction: row;
    justify-content: center;
}

.hidden {
    display: none;
}
