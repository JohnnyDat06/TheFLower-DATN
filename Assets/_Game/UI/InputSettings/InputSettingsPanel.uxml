<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/InputSettings/InputSettingsPanel.uss?fileID=7433441132597879392&amp;guid=d8ee345c9225f2248b7a02a8737daeb6&amp;type=3#InputSettingsPanel" />
    <ui:VisualElement name="panel-overlay" class="panel-overlay hidden">
        <ui:VisualElement name="panel-container" class="panel-container">
            <ui:VisualElement class="title-row">
                <ui:VisualElement class="title-emblem">
                    <ui:Label text="*" class="emblem-text" />
                </ui:VisualElement>
                <ui:Label name="title" text="Key Bindings" class="title" />
            </ui:VisualElement>
            <ui:VisualElement name="device-mode-buttons" class="device-mode-buttons">
                <ui:Button name="btn-mode-keyboard" text="Keyboard / Mouse" focusable="true" tabindex="1" class="mode-button mode-active" />
                <ui:Button name="btn-mode-gamepad" text="Gamepad" focusable="true" tabindex="2" class="mode-button" />
            </ui:VisualElement>
            <ui:VisualElement name="gamepad-map" class="gamepad-map hidden">
                <ui:VisualElement class="gamepad-diagram">
                    <ui:VisualElement class="gamepad-image" style="translate: 37px 0;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="header-row" class="rebind-row header-row">
                <ui:Label class="col-action" />
                <ui:Label name="header-keyboard" text="Keyboard" class="col-binding col-header" />
                <ui:Label name="header-mouse" text="Mouse" class="col-binding col-header" />
                <ui:Label name="header-gamepad" text="Gamepad" class="col-binding col-header hidden" />
            </ui:VisualElement>
            <ui:ScrollView name="rebind-list" class="rebind-list" />
            <ui:VisualElement name="sensitivity-section" class="sensitivity-section">
                <ui:Label text="Gamepad Camera Sensitivity" class="setting-label" />
                <ui:Slider name="gamepad-sensitivity" low-value="0.1" high-value="3" value="1" focusable="true" tabindex="100" class="sensitivity-slider" />
                <ui:Label name="sensitivity-value" text="100%" class="sensitivity-value-label" />
            </ui:VisualElement>
            <ui:VisualElement class="description-panel">
                <ui:Label text="Select which action to assign" class="description-text" />
            </ui:VisualElement>
            <ui:VisualElement name="button-row" class="button-row">
                <ui:VisualElement class="footer-hints">
                    <ui:Label name="footer-ok-hint" text="A : OK" class="footer-hint ok-hint" />
                    <ui:Label name="footer-back-hint" text="B : Back" class="footer-hint back-hint" />
                    <ui:Label text="X : Reset assignments" class="footer-hint" />
                    <ui:Label text="Y : Defaults" class="footer-hint" />
                    <ui:Label name="footer-cancel-hint" text="Menu : Cancel rebind" class="footer-hint" />
                </ui:VisualElement>
                <ui:VisualElement class="footer-buttons">
                    <ui:Button name="btn-reset-all" text="Reset All" focusable="true" tabindex="200" class="action-button reset-button" />
                    <ui:Button name="btn-back" text="Back" focusable="true" tabindex="201" class="action-button back-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="rebind-overlay" class="modal-overlay hidden">
        <ui:VisualElement class="modal-content">
            <ui:Label name="rebind-prompt" text="Press any key..." class="modal-prompt" />
            <ui:Button name="btn-cancel-rebind" text="Cancel" focusable="true" class="action-button back-button" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="conflict-overlay" class="modal-overlay hidden">
        <ui:VisualElement class="modal-content">
            <ui:Label name="conflict-prompt" text="Conflict" class="modal-prompt" />
            <ui:VisualElement class="modal-button-row">
                <ui:Button name="btn-confirm-conflict" text="Swap" focusable="true" class="action-button confirm-button" />
                <ui:Button name="btn-cancel-conflict" text="Cancel" focusable="true" class="action-button back-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
