<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="InputSettingsPanel.uss" />
    <ui:VisualElement name="panel-overlay" class="panel-overlay hidden">
        <ui:VisualElement name="panel-container" class="panel-container">
            <ui:VisualElement class="title-row">
                <ui:VisualElement class="title-emblem" />
                <ui:Label name="title" text="Key Bindings" class="title" />
            </ui:VisualElement>

            <ui:VisualElement name="device-mode-section" class="device-mode-section">
                <ui:Label text="Controller Settings" class="section-label" />
                <ui:Label name="tab-switch-hint" text="LB / RB (L1 / R1) : Switch tab" class="tab-switch-hint" />
                <ui:VisualElement name="device-mode-buttons" class="device-mode-buttons">
                    <ui:Button name="btn-mode-keyboard" text="Keyboard / Mouse" class="mode-button mode-active" focusable="true" tabindex="1" />
                    <ui:Button name="btn-mode-gamepad" text="Gamepad" class="mode-button" focusable="true" tabindex="2" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="gamepad-map" class="gamepad-map hidden">
                <ui:VisualElement class="gamepad-diagram">
                    <ui:VisualElement class="gamepad-image" />
                    <ui:VisualElement class="connector connector-lb" />
                    <ui:VisualElement class="connector connector-rb" />
                    <ui:VisualElement class="connector connector-lt" />
                    <ui:VisualElement class="connector connector-rt" />
                    <ui:VisualElement class="connector connector-dpad" />
                    <ui:VisualElement class="connector connector-left-stick" />
                    <ui:VisualElement class="connector connector-right-stick" />
                    <ui:VisualElement class="connector connector-face" />
                    <ui:VisualElement class="connector connector-menu" />
                    <ui:Label text="LB / L1  Guard" class="pad-callout callout-lb" />
                    <ui:Label text="RB / R1  Attack" class="pad-callout callout-rb" />
                    <ui:Label text="LT  Skill" class="pad-callout callout-lt" />
                    <ui:Label text="RT  Strong Attack" class="pad-callout callout-rt" />
                    <ui:Label text="L  Movement" class="pad-callout callout-left-stick" />
                    <ui:Label text="R  Camera / Lock" class="pad-callout callout-right-stick" />
                    <ui:Label text="D-Pad  Switch Items" class="pad-callout callout-dpad" />
                    <ui:Label text="Y  Interact" class="pad-callout callout-y" />
                    <ui:Label text="X  Use Item" class="pad-callout callout-x" />
                    <ui:Label text="B  Back / Dodge" class="pad-callout callout-b" />
                    <ui:Label text="A  OK / Jump" class="pad-callout callout-a" />
                    <ui:Label text="Menu  Pause / Cancel" class="pad-callout callout-menu" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="header-row" class="rebind-row header-row">
                <ui:Label text="" class="col-action" />
                <ui:Label name="header-keyboard" text="Keyboard" class="col-binding col-header" />
                <ui:Label name="header-mouse" text="Mouse" class="col-binding col-header" />
                <ui:Label name="header-gamepad" text="Gamepad" class="col-binding col-header hidden" />
            </ui:VisualElement>

            <ui:ScrollView name="rebind-list" class="rebind-list" />

            <ui:VisualElement name="sensitivity-section" class="sensitivity-section">
                <ui:Label text="Gamepad Camera Sensitivity" class="setting-label" />
                <ui:Slider name="gamepad-sensitivity" low-value="0.1" high-value="3" value="1" class="sensitivity-slider" focusable="true" tabindex="100" />
                <ui:Label name="sensitivity-value" text="100%" class="sensitivity-value-label" />
            </ui:VisualElement>

            <ui:VisualElement class="description-panel">
                <ui:Label text="Select which action to assign" class="description-text" />
            </ui:VisualElement>

            <ui:VisualElement name="button-row" class="button-row">
                <ui:VisualElement class="footer-hints">
                    <ui:Label name="footer-ok-hint" text="A : OK" class="footer-hint ok-hint" />
                    <ui:Label name="footer-back-hint" text="B : Back" class="footer-hint back-hint" />
                    <ui:Label text="X : Reset assignments" class="footer-hint" />
                    <ui:Label text="Y : Defaults" class="footer-hint" />
                    <ui:Label name="footer-cancel-hint" text="Menu : Cancel rebind" class="footer-hint" />
                </ui:VisualElement>
                <ui:VisualElement class="footer-buttons">
                    <ui:Button name="btn-reset-all" text="Reset All" class="action-button reset-button" focusable="true" tabindex="200" />
                    <ui:Button name="btn-back" text="Back" class="action-button back-button" focusable="true" tabindex="201" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="rebind-overlay" class="modal-overlay hidden">
        <ui:VisualElement class="modal-content">
            <ui:Label name="rebind-prompt" text="Press any key..." class="modal-prompt" />
            <ui:Button name="btn-cancel-rebind" text="Cancel" class="action-button back-button" focusable="true" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="conflict-overlay" class="modal-overlay hidden">
        <ui:VisualElement class="modal-content">
            <ui:Label name="conflict-prompt" text="Conflict" class="modal-prompt" />
            <ui:VisualElement class="modal-button-row">
                <ui:Button name="btn-confirm-conflict" text="Swap" class="action-button confirm-button" focusable="true" />
                <ui:Button name="btn-cancel-conflict" text="Cancel" class="action-button back-button" focusable="true" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
